# Required environment variables for the Slack Expense Tracker Bot

# Google Sheets Configuration
SPREADSHEET_ID=your_google_sheet_id_here

# Google Service Account Credentials (full JSON string, not base64 encoded)
GOOGLE_CREDS_JSON={
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your-private-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "your-service-account@your-project.iam.gserviceaccount.com"
}

# Dropbox Configuration
DROPBOX_TOKEN=your_dropbox_access_token_here

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Server Configuration
PORT=5000
FLASK_DEBUG=false

# Optional: Set to 'true' for additional debug output
LOG_LEVEL=INFO